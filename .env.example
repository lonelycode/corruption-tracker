#
# Copy to .env next to docker-compose.yml. Or generate it in one go:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" > .env

# Required: the database password. Use letters and digits only (it goes
# into a connection URL); the one-liner above makes a suitable one.
POSTGRES_PASSWORD=

# Optional: HTTPS on a server with a domain name pointing at it. Caddy
# gets a Let's Encrypt certificate automatically (ports 80 and 443 must be
# reachable).
# TRACKER_DOMAIN=tracker.example.org
# COMPOSE_PROFILES=https

# Optional: the key that encrypts stored secrets (LLM key, mailbox
# password), instead of the generated secret.key on the data volume. The
# same value on two servers lets a restored backup read them without
# copying secret.key. Set it before the first secret is saved, or never.
# Switching later doesn't lose data, but the LLM key and mailbox password
# must be re-entered on Settings. Make one with:
#   echo "TRACKER_SECRET=$(openssl rand -hex 32)" >> .env
# TRACKER_SECRET=

# Everything else is set on the admin Settings page after setup.
