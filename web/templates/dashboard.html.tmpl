{{define "title"}}Fraud tracker{{end}}

{{define "content"}}
{{with .Data}}
{{$csrf := $.CSRFToken}}
<main class="page dossier-surface">
  <div class="dossier-kicker">Admin &middot; fraud tracker</div>
  <h1 class="dossier-heading">Corruption &amp; fraud tracker</h1>
  <p class="dossier-sub">
    Review-gated, org-flag-gated, never public. Connectors land unverified claims in the
    <a href="/admin/fraud/claims">queue</a>; verified claims promote into the
    <a href="/admin/fraud/cases">case register</a>; the weekly
    <a href="/tracker/corruption">report</a> is built from verified cases only.
    The <a href="/admin/fraud/appeals">appeal worklist</a> schedules the manual JDO/NZLII checks;
    the <a href="/admin/fraud/duplicates">duplicate review</a> folds repeated case records together.
  </p>

  <div class="row" style="gap:24px; align-items:flex-start; flex-wrap:wrap">
    <div class="panel" style="min-width:260px">
      <div class="dossier-kicker">Claims queue</div>
      <table class="dossier-table">
        <tbody>
          {{range $state, $n := .ClaimCounts}}
          <tr>
            <td><a href="/admin/fraud/claims?state={{$state}}">{{$state}}</a></td>
            <td class="mono" style="text-align:right">{{$n}}</td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>

    <div class="panel" style="min-width:300px">
      <div class="dossier-kicker">Cases (status &middot; review)</div>
      <table class="dossier-table">
        <tbody>
          {{range $k, $n := .CaseCounts}}
          <tr><td class="mono" style="font-size:11.5px">{{$k}}</td><td class="mono" style="text-align:right">{{$n}}</td></tr>
          {{end}}
        </tbody>
      </table>
    </div>

    {{with .Coverage}}
    <div class="panel" style="min-width:300px">
      <div class="dossier-kicker">Coding coverage &middot; {{.Total}} cases</div>
      <p style="font-size:12px; color:var(--fg-3)">The daily <span class="mono">fraud recode</span> sweep
      pushes these to 100%; the remainder is the human worklist (filter the
      <a href="/tracker/corruption/explorer">explorer</a> for uncoded rows).</p>
      <table class="dossier-table">
        <tbody>
          <tr><td>Typology coded</td><td class="mono" style="text-align:right">{{.TypologyCoded}}/{{.Total}}</td></tr>
          <tr><td>Agency coded <span style="color:var(--fg-3); font-size:11px">({{.AgencyInferred}} inferred)</span></td>
              <td class="mono" style="text-align:right">{{.AgencyCoded}}/{{.Total}}</td></tr>
          <tr><td>Region coded</td><td class="mono" style="text-align:right">{{.RegionCoded}}/{{.Total}}</td></tr>
          <tr><td>Sector coded</td><td class="mono" style="text-align:right">{{.SectorCoded}}/{{.Total}}</td></tr>
          <tr><td>Offending period known</td><td class="mono" style="text-align:right">{{.OffendingPeriod}}/{{.Total}}</td></tr>
          <tr><td>Conviction date recorded</td><td class="mono" style="text-align:right">{{.ConvictionDated}}/{{.Total}}</td></tr>
          <tr><td>Participant charges recorded</td><td class="mono" style="text-align:right">{{.ParticipantCharges}}/{{.Participants}}</td></tr>
          <tr><td>Awaiting recode attempt</td><td class="mono" style="text-align:right">{{.RecodeUnattempt}}</td></tr>
        </tbody>
      </table>
    </div>
    {{end}}
  </div>{{.HostPanel}}</main>
{{end}}
{{end}}
